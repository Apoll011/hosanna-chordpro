{
  "name": "@hosanna/chordpro",
  "version": "1.3.1",
  "license": "Apache-2.0",
  "description": "ChordPro parser, renderer, and editor for Hosanna",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.mjs",
      "require": "./dist/parser/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.mjs",
      "require": "./dist/renderer/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.mjs",
      "require": "./dist/editor/index.js"
    },
    "./formatter": {
      "types": "./dist/formatter/index.d.ts",
      "import": "./dist/formatter/index.mjs",
      "require": "./dist/formatter/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/parser/index.ts src/renderer/index.ts src/editor/index.ts src/formatter/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/parser/index.ts src/renderer/index.ts src/editor/index.ts src/formatter/index.ts --watch --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/youtube-player": "^5.5.11",
    "ace-builds": "^1.44.0",
    "react-ace": "^15.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ace-builds": "^1.44.0",
    "react-ace": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "ace-builds": {
      "optional": true
    },
    "react-ace": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-youtube": "^10.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
